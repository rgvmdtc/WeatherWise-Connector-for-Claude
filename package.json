{
  "name": "weatherwise-connector-for-claude",
  "version": "1.0.0",
  "description": "MCP connector that lets Claude use WeatherWise (web.weatherwise.app) via a browser-based scraper, plus open severe-weather data sources (NWS, SPC, NHC, DWD, Open-Meteo, RainViewer).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "weatherwise-connector": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "login": "node dist/index.js login",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.14",
    "typescript": "6.0.3"
  }
}
