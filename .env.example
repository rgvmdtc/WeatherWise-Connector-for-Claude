# --- WeatherWise web app (browser/scraper tools) ---
# WEATHERWISE_URL=https://web.weatherwise.app
# Account for automatic login (the web app requires WeatherWise Plus/Pro).
# Alternative: run `npm run login` once and sign in by hand.
WEATHERWISE_EMAIL=
WEATHERWISE_PASSWORD=
# Where the browser profile (login) and the discovered API catalog are stored.
# WEATHERWISE_DATA_DIR=~/.weatherwise-connector
# WEATHERWISE_HEADLESS=true
# WEATHERWISE_BROWSER=true          # false = only the open-data weather tools
# WEATHERWISE_ALLOW_EVAL=false      # true = enable ww_evaluate (run JS in the app tab)
# WEATHERWISE_API_HOSTS=            # extra hosts ww_call_api may contact (comma separated)
# WEATHERWISE_VIEWPORT_WIDTH=1280
# WEATHERWISE_VIEWPORT_HEIGHT=800
# CHROMIUM_PATH=/usr/bin/chromium

# --- HTTP mode (claude.ai custom connector) ---
# MCP_TRANSPORT=http
# HOST=0.0.0.0
# PORT=3000
# MCP_PATH=/mcp
# Strongly recommended when the server is reachable from the internet:
MCP_AUTH_TOKEN=
# ALLOWED_HOSTS=my-connector.example.com

# --- Misc ---
# CONTACT=you@example.com           # sent in the User-Agent (api.weather.gov asks for a contact)
# RADAR_MAX_ZOOM=7
